<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu.uss" />

    <!-- Contenedor a pantalla completa (aquí puedes poner una imagen de fondo desde el USS) -->
    <ui:VisualElement name="root" class="root">

        <!-- Luna decorativa -->
        <ui:VisualElement name="moon" class="moon" picking-mode="Ignore" />

        <!-- Zona del título -->
        <ui:VisualElement name="title-container" class="title-container">
            <ui:Label name="title" text="MOONVEIL" class="title" />
            <ui:VisualElement name="title-line" class="title-line" />
            <ui:Label name="subtitle" text="Tras el velo de la luna" class="subtitle" />
        </ui:VisualElement>

        <!-- Botones -->
        <ui:VisualElement name="menu-buttons" class="menu-buttons">
            <ui:Button name="btn-play" text="JUGAR" class="menu-button" />
            <ui:Button name="btn-settings" text="CONFIGURACIÓN" class="menu-button" />
            <ui:Button name="btn-quit" text="SALIR" class="menu-button menu-button--quit" />
        </ui:VisualElement>

        <!-- Versión -->
        <ui:Label name="version" text="v0.1" class="version" />

    </ui:VisualElement>
</ui:UXML>
