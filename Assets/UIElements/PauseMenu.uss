.pause-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
}

.player-name-tag {
    position: absolute;
    width: 190px;
    height: 34px;
    padding: 5px 10px;
    color: rgb(225, 230, 255);
    background-color: rgba(10, 12, 28, 0.9);
    border-width: 1px;
    border-color: rgba(140, 160, 255, 0.75);
    border-radius: 18px;
    -unity-font-style: bold;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 28, 0.82);
}

.pause-panel {
    width: 460px;
    flex-shrink: 0;
    padding: 26px 36px 30px;
    align-items: center;
    background-color: rgba(10, 12, 28, 0.97);
    border-width: 3px;
    border-color: rgb(140, 160, 255);
    border-radius: 18px;
}

.pause-moon {
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
    background-color: rgb(220, 228, 255);
    border-width: 4px;
    border-color: rgba(140, 160, 255, 0.35);
    border-radius: 24px;
}

.pause-title {
    color: rgb(220, 228, 255);
    font-size: 36px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-subtitle {
    margin-top: 6px;
    margin-bottom: 20px;
    color: rgb(225, 230, 255);
    font-size: 15px;
}

.pause-button {
    width: 100%;
    height: 52px;
    margin: 6px 0;
    color: rgb(225, 230, 255);
    background-color: rgba(25, 30, 65, 0.95);
    border-width: 2px;
    border-color: rgba(140, 160, 255, 0.55);
    border-radius: 28px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.pause-button:hover {
    color: white;
    background-color: rgba(70, 85, 170, 0.95);
    border-color: rgb(220, 228, 255);
}

.pause-button:focus {
    border-color: rgb(220, 228, 255);
}

.pause-button--primary {
    background-color: rgba(40, 50, 110, 1);
}

.pause-button--secondary {
    margin-top: 12px;
    background-color: rgba(25, 30, 65, 0.95);
}
